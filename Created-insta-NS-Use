apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginxwala
  namespace: instagram
  labels:
    app: nginxwala

spec:
  replicas: 2
  selector:
    matchLabels:
      app: nginxwala

  template:
    metadata:
      labels:
        app: nginxwala

    spec:
      containers:
        - name: mycontainer
          image: nginx
          ports:
            - containerPort: 80

          livenessProbe:
            httpGet:
              path: /index.html
              port: 80
